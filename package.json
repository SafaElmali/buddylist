{
  "name": "buddylist",
  "productName": "buddylist",
  "version": "0.7.2",
  "description": "Run coding agents side by side in one app.",
  "main": "src/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/name-dev-app.js",
    "start": "electron .",
    "demo": "BUDDYLIST_DEMO=1 electron .",
    "preview:web": "node scripts/build-web-preview.js",
    "build:app": "node scripts/build-app.js",
    "build:site": "node scripts/build-site.js",
    "deploy:site": "npx --yes wrangler@4 deploy",
    "feedback": "npx --yes wrangler@4 kv key list --binding FEEDBACK --remote --prefix feedback:",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "icon": "electron scripts/make-icon.js",
    "screenshot": "node scripts/make-screenshot.js",
    "promo": "node scripts/make-promo.js",
    "video": "node scripts/make-video.js",
    "og-image": "node scripts/make-og-image.js",
    "dist": "npm run build:app && electron-builder --mac",
    "dist:win": "npm run build:app && electron-builder --win -c.npmRebuild=false",
    "dist:linux": "npm run build:app && electron-builder --linux -c.npmRebuild=false",
    "release": "gh workflow run build-app.yml --ref main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SafaElmali/buddylist.git"
  },
  "homepage": "https://buddylist.dev",
  "author": {
    "name": "T. Safa Elmalı",
    "email": "tsafaelmali@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.0",
    "node-pty": "1.2.0-beta.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/electron": "^8.1.0",
    "@sentry/esbuild-plugin": "^5.4.1",
    "electron": "^44.10.2",
    "electron-builder": "^26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "dev.buddylist.app",
    "productName": "buddylist",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SafaElmali",
        "repo": "buddylist"
      }
    ],
    "files": [
      "package.json",
      "!node_modules/{dompurify,marked,node-addon-api,@xterm/addon-fit,@xterm/addon-search,@xterm/addon-serialize,@xterm/headless,@types/trusted-types}/**",
      "!node_modules/@xterm/xterm/{lib,src,typings}",
      "!node_modules/@anthropic-ai/claude-agent-sdk/{bridge.mjs,browser-sdk.js,core*.mjs,extractFromBunfs.js}",
      "!node_modules/zod/{src,v3}",
      "!node_modules/zod/**/*.d.cts",
      {
        "from": "dist/app",
        "to": "src"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "dist/app/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "buddylist-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "/claude-agent-sdk-darwin-[^/]+/claude$"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "buddylist listens while you hold F2 to record a voice clip, and turns what you say into text on your Mac.",
        "NSAppleEventsUsageDescription": "buddylist reads the song playing in Spotify or Apple Music when you turn on Show what I'm listening to."
      }
    },
    "dmg": {
      "format": "ULFO",
      "writeUpdateInfo": false
    },
    "afterAllArtifactBuild": "./scripts/compress-dmg.js",
    "win": {
      "icon": "build/icon.png",
      "artifactName": "buddylist-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Your coding agents, side by side",
      "artifactName": "buddylist-linux-${arch}.${ext}"
    }
  }
}
