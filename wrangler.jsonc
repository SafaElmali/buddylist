{
  // Named for what the app was called before it was buddylist, and kept: the old address,
  // agent-messenger.<account>.workers.dev, is this Worker's own for as long as it has this name.
  // Copies of the app from before the rename send their feedback there, and it redirects them.
  "name": "agent-messenger",
  "account_id": "b188e6cecb16d13fe2f4dbb8916e2dc2",
  // Redirects the old hostname, answers forms, and serves the page's static files.
  "main": "site/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "routes": [
    { "pattern": "buddylist.dev", "custom_domain": true },
    { "pattern": "www.buddylist.dev", "custom_domain": true },
  ],
  "build": {
    "command": "npm run build:site",
  },
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    // Redirect old URLs before Cloudflare serves a matching static file.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  "kv_namespaces": [
    // Feedback, bugs and requests from the page and the app, with their screenshots (npm run feedback).
    { "binding": "FEEDBACK", "id": "1fcc1185d12947b7b1e655fd3dc9ef17" },
  ],
  "ratelimits": [
    // How often one sender may post each form. A person sends one; a script sends thousands.
    { "name": "FORM_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
}
