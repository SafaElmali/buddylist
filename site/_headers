# The demo is the app's windows, not a page to land on from a search.
/demo/*
  X-Robots-Tag: noindex
# A guide's Markdown is the page beside it again, for reading; the page is the one to find.
/docs/:guide.md
  X-Robots-Tag: noindex
/*
  Strict-Transport-Security: max-age=2592000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests
